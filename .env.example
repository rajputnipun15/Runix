# ==========================================
# RUNIX Environment Configuration Template
# ==========================================

# Application
NODE_ENV=development
APP_PORT=3000
API_PORT=8000
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Database (PostgreSQL / SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./runix_dev.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:your_db_password_here@localhost:5432/runix_dev

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
SESSION_SECRET=your_session_secret_key_here

# GitHub OAuth Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# AI Agent Configuration
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro

# Runtime & Sandbox Engine
RUNTIME_CONTAINER_NETWORK=runix-sandbox-net
STORAGE_WORKSPACE_DIR=/tmp/runix/workspaces
